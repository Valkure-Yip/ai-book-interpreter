# Copy to .env and fill in your keys.

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Langfuse (optional; missing keys = no-op)
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_FULL_PAYLOAD=0

# Pipeline tuning (optional; leave unset to use defaults).
# Sliding-window size around each paragraph during Pass 2 translation.
# Larger = more context, more tokens per request.
ABI_WINDOW_BEFORE=3
ABI_WINDOW_AFTER=2

# Short-chapter override: when a chapter has <= N paragraphs, ignore the
# sliding-window limits above and pass the WHOLE chapter as context to every
# paragraph in it. Levels the playing field against naive single-prompt
# baselines on short documents (news commentary, essays, blog posts).
# Set to 0 to disable.
ABI_SHORT_CHAPTER_THRESHOLD=15

# Paragraphs translated per LLM request. 1 = one paragraph per request (default,
# best quality — every paragraph sees prior translations). >1 = batch K
# consecutive paragraphs into one prompt; ~K× fewer requests but paragraphs in
# the same batch don't see each other's translations. Recommended: 2-5.
ABI_BATCH_SIZE=1

# Chapter-level parallelism. Equivalent to `--concurrency` on the CLI.
ABI_CONCURRENCY=4

# LLM-based TOC refinement (default ON). Runs once per book between ingest and
# survey to correct heuristic chapter-detection mistakes (e.g. Roman-numeral
# headings the regex parser misses, false-positive ALL-CAPS lines, etc.).
# Set to 0 to skip — saves one LLM call when the heuristic structure is already
# correct or when running fully offline.
ABI_TOC_REFINE=1

# Where to store run artifacts (ingest IR, survey output, paragraph checkpoints,
# events.jsonl, metrics.json). Defaults to ./runs under CWD.
# ABI_RUNS_DIR=./runs

# Eval judge model (optional; defaults to LLM_MODEL when unset).
# Use this to point the LLM-as-judge at a stronger model than the translator.
# Endpoint (LLM_BASE_URL) and API key (LLM_API_KEY) are always reused.
# EVAL_JUDGE_MODEL=gpt-4o

# Optional Langfuse project id used to build per-run UI URLs in `abi eval`
# output. Read off the Langfuse dashboard's URL bar.
# LANGFUSE_PROJECT_ID=

# Local cache dir for HuggingFace datasets. Currently used by:
#   - wmt24pp:en-zh_CN:literary        (literary register)
#   - news_commentary:en-zh:academic-accessible  (academic-accessible register)
# HF_DATASETS_CACHE=~/.cache/huggingface
