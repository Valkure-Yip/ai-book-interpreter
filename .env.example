# Copy to .env and fill in your keys.

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# Set to disabled only for providers whose thinking mode rejects agent tool_choice.
ABI_LLM_THINKING=provider_default

# Langfuse (optional; missing keys = no-op)
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_FULL_PAYLOAD=0

# Orchestration tuning (optional; leave unset to use defaults).
# Max concurrent LLM calls (shared across structured + agent calls).
ABI_MAX_CONCURRENCY=4
# Max agent retries per stage before the orchestrator marks the run blocked.
ABI_MAX_STAGE_ATTEMPTS=3
# Stop when one semantic incident has consumed this many unsuccessful replacement Actions.
ABI_MAX_SEMANTIC_REPAIR_ATTEMPTS=3
# Consecutive passing random-spot-check rounds required to clear the gate.
ABI_SPOTCHECK_PASS_ROUNDS=2

# EPUBCheck (Java tool, required by the build gate). Resolution order:
#   1. ABI_EPUBCHECK_JAR (java -jar <jar>)
#   2. the `epub` extra's bundled jar (pip install ai-book-interpreter[epub])
#   3. an `epubcheck` executable on PATH
# A JRE (`java` on PATH) is required in all cases.
# ABI_EPUBCHECK_JAR=/path/to/epubcheck.jar
